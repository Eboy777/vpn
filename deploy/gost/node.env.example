# Demonstration values only. Replace every identity, URL and credential before deployment.
CONTROL_API_BASE_URL=https://api-a.example.com
CONTROL_API_FALLBACK_URLS_JSON=["https://api-b.example.com"]
NODE_ID=00000000-0000-0000-0000-000000000000
NODE_CREDENTIALS_TOKEN=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
NODE_SYNC_INTERVAL_SECONDS=30
NODE_SYNC_TIMEOUT_SECONDS=15
NODE_SYNC_JITTER_SECONDS=5
NODE_STALE_SNAPSHOT_POLICY=fail_closed
NODE_SYNC_STATE_PATH=/var/lib/vpn-node/state.json
GOST_CONFIG_PATH=/var/lib/vpn-node/auth.txt
GOST_CONFIG_STAGING_PATH=/var/lib/vpn-node/auth.staging
GOST_CANARY_PROXY_USERNAME=replace_canary_username
GOST_CANARY_PROXY_PASSWORD=replace_with_unique_canary_password
GOST_CANARY_CREDENTIAL_VERSION=v1
GOST_RELOAD_TIMEOUT_SECONDS=15

#!/usr/sbin/nft -f

# This file owns only table inet vpn_node and does not flush unrelated firewall tables.
# `add` is idempotent; the following flush and rebuild are applied in one nft transaction.
add table inet vpn_node
flush table inet vpn_node

table inet vpn_node {
    set blocked_ipv4 {
        type ipv4_addr
        flags interval
        elements = {
            0.0.0.0/8,
            10.0.0.0/8,
            100.64.0.0/10,
            127.0.0.0/8,
            169.254.0.0/16,
            172.16.0.0/12,
            192.0.0.0/24,
            192.0.2.0/24,
            192.168.0.0/16,
            198.18.0.0/15,
            198.51.100.0/24,
            203.0.113.0/24,
            224.0.0.0/4,
            240.0.0.0/4
        }
    }

    set blocked_ipv6 {
        type ipv6_addr
        flags interval
        elements = {
            ::/128,
            ::1/128,
            fc00::/7,
            fe80::/10,
            ff00::/8
        }
    }

    chain input {
        type filter hook input priority filter; policy drop;
        ct state invalid drop
        ct state established,related accept
        iifname "lo" accept

        # ICMP/ICMPv6 is required for diagnostics and path-MTU discovery, but it is bounded.
        ip protocol icmp limit rate 100/second burst 200 packets accept
        ip6 nexthdr ipv6-icmp limit rate 100/second burst 200 packets accept

        # Replace/remove both documentation addresses before deployment. SSH is never public.
        ip saddr 203.0.113.10/32 tcp dport 22 ct state new limit rate 10/minute burst 5 packets accept
        ip6 saddr 2001:db8::10/128 tcp dport 22 ct state new limit rate 10/minute burst 5 packets accept

        # Coarse node-wide SYN protection. Per-IP request/connection limits live in GOST.
        tcp dport 443 tcp flags syn limit rate over 2000/second burst 4000 packets counter drop
        tcp dport 443 accept
    }

    chain forward {
        type filter hook forward priority filter; policy drop;
    }

    chain output {
        type filter hook output priority filter; policy accept;

        # Scope egress restrictions to the dedicated GOST account. Do not block host SSH.
        # Permit replies on client-initiated proxy connections before limiting new GOST egress.
        meta skuid "gost" ct state established,related accept

        # GOST needs its loopback observer and DNS before private ranges are rejected.
        meta skuid "gost" ip daddr 127.0.0.1 tcp dport 9001 accept
        meta skuid "gost" udp dport 53 accept
        meta skuid "gost" tcp dport 53 accept

        meta skuid "gost" tcp dport { 22, 25, 465, 587, 2525 } counter reject with tcp reset
        meta skuid "gost" ip daddr @blocked_ipv4 counter reject with icmpx type admin-prohibited
        meta skuid "gost" ip6 daddr @blocked_ipv6 counter reject with icmpx type admin-prohibited

        # Browser traffic is limited to standard web ports. Reject all other GOST egress,
        # including BitTorrent peer ports and UDP transports such as DHT/uTP.
        meta skuid "gost" tcp dport { 80, 443 } accept
        meta skuid "gost" counter reject with icmpx type admin-prohibited
    }
}

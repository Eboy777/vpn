[Unit]
Description=VPN GOST credential sync agent
After=network-online.target gost.service
Wants=network-online.target
Requires=gost.service

[Service]
Type=simple
User=root
Group=gost
UMask=0027
EnvironmentFile=/etc/vpn-node/node.env
ExecStart=/opt/vpn-node/bin/vpn-node-sync
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/vpn-node

[Install]
WantedBy=multi-user.target

server {
    listen 80;
    listen [::]:80;
    server_name api.virgo-vpn.site proxy1.virgo-vpn.site proxy2.virgo-vpn.site;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name proxy1.virgo-vpn.site proxy2.virgo-vpn.site;

    ssl_certificate /etc/letsencrypt/live/api.virgo-vpn.site/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/api.virgo-vpn.site/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    client_max_body_size 1m;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $request_id;
        proxy_connect_timeout 5s;
        proxy_read_timeout 35s;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name api.virgo-vpn.site;

    ssl_certificate /etc/letsencrypt/live/api.virgo-vpn.site/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/api.virgo-vpn.site/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    client_max_body_size 128k;

    location = /api/payments/lava/webhook/payment {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $request_id;
        proxy_connect_timeout 5s;
        proxy_read_timeout 35s;
    }

    location = /api/payments/lava/webhook/recurring {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $request_id;
        proxy_connect_timeout 5s;
        proxy_read_timeout 35s;
    }

    location / {
        return 404;
    }
}

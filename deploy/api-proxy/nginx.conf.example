worker_processes auto;

events {
    worker_connections 2048;
}

http {
    # Never log URI/query, headers, or bodies: pairing and webhook paths contain secrets.
    log_format safe '$remote_addr $request_method $status $body_bytes_sent '
                    '$request_time $upstream_response_time $request_id';
    access_log /var/log/nginx/access.log safe;
    # Request-specific upstream errors can contain a secret path; keep only process-critical logs.
    error_log /var/log/nginx/error.log crit;

    # Edge limits absorb ordinary floods before requests consume backend/database resources.
    limit_req_zone $binary_remote_addr zone=public_api_per_ip:20m rate=30r/s;
    limit_req_zone $binary_remote_addr zone=admin_api_per_ip:10m rate=5r/s;
    limit_req_zone $binary_remote_addr zone=loki_push_per_ip:10m rate=10r/s;
    limit_conn_zone $binary_remote_addr zone=public_connections_per_ip:20m;
    limit_req_status 429;
    limit_conn_status 429;

    server_tokens off;
    client_max_body_size 1m;
    client_body_timeout 10s;
    client_header_timeout 10s;
    keepalive_timeout 30s;
    keepalive_requests 200;
    large_client_header_buffers 2 8k;

    upstream vpn_control_origin {
        # Private WireGuard address of the single control origin.
        server 10.77.0.1:8000;
        keepalive 32;
    }

    upstream vpn_loki_origin {
        # Loki is exposed only on the origin's WireGuard address.
        server 10.77.0.1:3100;
        keepalive 8;
    }

    server {
        listen 80;
        listen [::]:80;
        server_name api-a.vpn.example bot.vpn.example;
        access_log off;
        return 404;
    }

    server {
        listen 443 ssl;
        listen [::]:443 ssl;
        http2 on;
        server_name api-a.vpn.example bot.vpn.example;

        ssl_certificate /etc/letsencrypt/live/api-proxy/fullchain.pem;
        ssl_certificate_key /etc/letsencrypt/live/api-proxy/privkey.pem;
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_session_cache shared:SSL:10m;
        ssl_session_timeout 1d;
        ssl_session_tickets off;

        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header X-Content-Type-Options nosniff always;

        # Prometheus reaches this endpoint only through the control host's private Docker network.
        location = /internal/metrics {
            return 404;
        }

        # Remote node logs use a separate credential and can only write, never query Loki.
        location = /loki/api/v1/push {
            limit_except POST { deny all; }
            auth_basic "Virgo log shipping";
            auth_basic_user_file /etc/nginx/loki.htpasswd;
            limit_req zone=loki_push_per_ip burst=20 nodelay;
            limit_conn public_connections_per_ip 5;
            client_max_body_size 2m;
            proxy_pass http://vpn_loki_origin;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Host $host;
            proxy_set_header X-Scope-OrgID "";
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_connect_timeout 5s;
            proxy_send_timeout 15s;
            proxy_read_timeout 15s;
        }

        location / {
            limit_except GET POST OPTIONS { deny all; }
            limit_req zone=public_api_per_ip burst=60 nodelay;
            limit_conn public_connections_per_ip 30;
            proxy_pass http://vpn_control_origin;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Proto https;
            # Overwrite, do not append, so a client cannot inject a fake left-most address.
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_set_header X-Request-ID $request_id;
            proxy_set_header Forwarded "";
            proxy_set_header X-Real-IP "";
            proxy_connect_timeout 5s;
            proxy_send_timeout 30s;
            proxy_read_timeout 30s;
            proxy_request_buffering off;
            proxy_buffering off;
            proxy_max_temp_file_size 0;
        }

        # Password authentication is also enforced by FastAPI. This tighter edge limit reduces
        # online password guessing and expensive password-hash verification.
        location /admin {
            limit_except GET POST { deny all; }
            limit_req zone=admin_api_per_ip burst=10 nodelay;
            limit_conn public_connections_per_ip 5;
            proxy_pass http://vpn_control_origin;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_set_header X-Request-ID $request_id;
            proxy_set_header Forwarded "";
            proxy_set_header X-Real-IP "";
            proxy_connect_timeout 5s;
            proxy_send_timeout 15s;
            proxy_read_timeout 15s;
            proxy_request_buffering off;
            proxy_buffering off;
        }
    }
}

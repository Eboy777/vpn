#!/usr/sbin/nft -f

table inet vpn_origin {
    chain input {
        type filter hook input priority filter; policy drop;
        ct state established,related accept
        iifname "lo" accept
        ip protocol icmp limit rate 100/second burst 200 packets accept
        ip6 nexthdr ipv6-icmp limit rate 100/second burst 200 packets accept

        # Replace with the administrator's fixed management network.
        ip saddr 203.0.113.10/32 tcp dport 22 ct state new limit rate 10/minute burst 5 packets accept
        udp dport 51820 accept
        iifname "wg0" ip saddr { 10.77.0.2, 10.77.0.3 } tcp dport { 8000, 3100 } accept
    }

    chain forward {
        type filter hook forward priority filter; policy drop;
        ct state established,related accept
        iifname "wg0" ip saddr { 10.77.0.2, 10.77.0.3 } tcp dport { 8000, 3100 } accept
    }

    chain output {
        type filter hook output priority filter; policy accept;
    }
}

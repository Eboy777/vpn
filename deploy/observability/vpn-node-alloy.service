[Unit]
Description=Virgo node journal shipper
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=alloy
Group=alloy
SupplementaryGroups=systemd-journal
EnvironmentFile=/etc/vpn-node/node.env
ExecStart=/usr/bin/alloy run --storage.path=/var/lib/alloy /etc/alloy/node.alloy
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/alloy

[Install]
WantedBy=multi-user.target

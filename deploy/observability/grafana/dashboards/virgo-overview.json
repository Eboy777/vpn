{
  "annotations": {"list": []},
  "editable": false,
  "graphTooltip": 1,
  "panels": [
    {
      "type": "stat",
      "title": "Первых запусков расширения",
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "virgo_extension_installations_total", "refId": "A"}]
    },
    {
      "type": "stat",
      "title": "Бесплатный период",
      "gridPos": {"h": 4, "w": 4, "x": 4, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "virgo_users{access=\"free\"}", "refId": "A"}]
    },
    {
      "type": "stat",
      "title": "Платная подписка",
      "gridPos": {"h": 4, "w": 4, "x": 8, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "virgo_users{access=\"paid\"}", "refId": "A"}]
    },
    {
      "type": "stat",
      "title": "Платёжных ссылок",
      "gridPos": {"h": 4, "w": 4, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "virgo_payment_links_created_total", "refId": "A"}]
    },
    {
      "type": "stat",
      "title": "Активные соединения",
      "gridPos": {"h": 4, "w": 4, "x": 16, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum(virgo_node_current_connections)", "refId": "A"}]
    },
    {
      "type": "stat",
      "title": "Ноды online",
      "gridPos": {"h": 4, "w": 4, "x": 20, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum(virgo_node_gost_up)", "refId": "A"}]
    },
    {
      "type": "timeseries",
      "title": "CPU / RAM / диск нод",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100}},
      "targets": [
        {"expr": "virgo_node_cpu_percent", "legendFormat": "CPU {{node_id}}", "refId": "A"},
        {"expr": "virgo_node_memory_percent", "legendFormat": "RAM {{node_id}}", "refId": "B"},
        {"expr": "virgo_node_disk_percent", "legendFormat": "Диск {{node_id}}", "refId": "C"}
      ]
    },
    {
      "type": "timeseries",
      "title": "Трафик нод",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "Bps"}},
      "targets": [
        {"expr": "rate(virgo_node_input_bytes_total[5m])", "legendFormat": "Входящий {{node_id}}", "refId": "A"},
        {"expr": "rate(virgo_node_output_bytes_total[5m])", "legendFormat": "Исходящий {{node_id}}", "refId": "B"}
      ]
    },
    {
      "type": "timeseries",
      "title": "Ошибки трафика и возраст телеметрии",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "increase(virgo_node_traffic_errors_total[5m])", "legendFormat": "Ошибки {{node_id}}", "refId": "A"},
        {"expr": "virgo_node_runtime_age_seconds", "legendFormat": "Возраст {{node_id}}", "refId": "B"}
      ]
    },
    {
      "type": "logs",
      "title": "Централизованные журналы",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12},
      "datasource": {"type": "loki", "uid": "loki"},
      "targets": [{"expr": "{source=~\"journald|.+\"}", "refId": "A"}]
    },
    {
      "type": "timeseries",
      "title": "Успешность и время подключения",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 20},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "virgo_connection_success_ratio_24h * 100", "legendFormat": "Успешно, %", "refId": "A"},
        {"expr": "virgo_connection_duration_ms{quantile=\"p95\"}", "legendFormat": "p95, мс", "refId": "B"},
        {"expr": "virgo_connection_duration_ms{quantile=\"p99\"}", "legendFormat": "p99, мс", "refId": "C"},
        {"expr": "avg by (country, provider) (virgo_node_canary_latency_by_location_ms)", "legendFormat": "Задержка {{country}} / {{provider}}, мс", "refId": "D"}
      ]
    },
    {
      "type": "timeseries",
      "title": "Заполненность и прогноз нод",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 20},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "virgo_node_capacity_ratio * 100", "legendFormat": "Заполнено {{node_id}}, %", "refId": "A"},
        {"expr": "virgo_node_estimated_capacity_exhaustion_hours", "legendFormat": "Осталось {{node_id}}, ч", "refId": "B"}
      ]
    },
    {
      "type": "timeseries",
      "title": "Скорость по странам и провайдерам",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 28},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "Bps"}},
      "targets": [
        {"expr": "sum by (country, provider) (rate(virgo_node_network_rx_bytes_total[5m]))", "legendFormat": "RX {{country}} / {{provider}}", "refId": "A"},
        {"expr": "sum by (country, provider) (rate(virgo_node_network_tx_bytes_total[5m]))", "legendFormat": "TX {{country}} / {{provider}}", "refId": "B"}
      ]
    },
    {
      "type": "timeseries",
      "title": "Переключения, переподключения и обрывы",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 28},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "virgo_node_failovers_24h", "legendFormat": "Переключения", "refId": "A"},
        {"expr": "virgo_reconnects_24h", "legendFormat": "Переподключения", "refId": "B"},
        {"expr": "virgo_unexpected_disconnect_ratio_24h * 100", "legendFormat": "Неожиданные обрывы, %", "refId": "C"}
      ]
    }
  ],
  "refresh": "15s",
  "schemaVersion": 41,
  "tags": ["virgo", "vpn"],
  "templating": {"list": []},
  "time": {"from": "now-6h", "to": "now"},
  "timezone": "browser",
  "title": "Virgo — здоровье и аналитика",
  "uid": "virgo-overview",
  "version": 1
}

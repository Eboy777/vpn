CONTROL_API_BASE_URL=https://api-a.vpn.example
CONTROL_API_FALLBACK_URLS_JSON=["https://api-b.vpn.example"]
CANARY_ID=replace-with-canary-uuid
CANARY_TOKEN=replace-with-43-character-canary-token
CANARY_CHECK_INTERVAL_SECONDS=60
CANARY_REQUEST_TIMEOUT_SECONDS=15
CANARY_CONTROL_FAILURE_ALERT_AFTER=3

# Optional but recommended: lets the Russian canary alert when the whole control VPS is down.
CANARY_ADMIN_TELEGRAM_BOT_TOKEN=replace-with-admin-monitoring-bot-token
CANARY_ADMIN_TELEGRAM_CHAT_IDS_JSON=[-1000000000001]
CANARY_PROBE_URLS_JSON=["https://probe-a.example/health","https://probe-b.example/health"]
# Each node uses its dedicated canary credential. Never commit real values.
CANARY_NODES_JSON=[{"node_id":"replace-with-node-uuid","host":"nl-1.vpn.example","port":443,"username":"canary_nl_1","password":"replace_with_32_character_secret"}]

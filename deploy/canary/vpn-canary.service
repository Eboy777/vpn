[Unit]
Description=Virgo external VPN canary
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=vpn-canary
Group=vpn-canary
UMask=0077
EnvironmentFile=/etc/vpn-canary/canary.env
ExecStart=/opt/vpn-canary/bin/vpn-canary
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target

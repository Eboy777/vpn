# Local-only example. Copy to .env and replace every value before any shared deployment.
APP_ENV=development
APP_PUBLIC_BASE_URL=http://localhost:8080
PUBLIC_CONTROL_URLS_JSON=["http://localhost:8080","http://localhost:8081"]
APP_BIND_HOST=0.0.0.0
APP_BIND_PORT=8000
LOG_LEVEL=INFO
LOG_FORMAT=json
PROCESS_ROLE=api

POSTGRES_DB=vpn
POSTGRES_USER=vpn
POSTGRES_PASSWORD=vpn-local-only
POSTGRES_LOCAL_PORT=55439
DATABASE_URL=postgresql+asyncpg://vpn:vpn-local-only@postgres:5432/vpn
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=10
DB_STATEMENT_TIMEOUT_MS=10000

WORKER_POLL_INTERVAL_SECONDS=1
OUTBOX_RETRY_BASE_SECONDS=5
OUTBOX_RETRY_MAX_SECONDS=300
OUTBOX_MAX_ATTEMPTS=10

# Deterministic dummy keys for local development only; never reuse in staging/production.
TOKEN_HASH_KEYRING_JSON={"device":{"v1":"AQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQE"},"pairing_session":{"v1":"AgICAgICAgICAgICAgICAgICAgICAgICAgICAgICAgI"},"telegram_start":{"v1":"AwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwM"},"node":{"v1":"BAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQ"},"canary":{"v1":"BQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQU"}}
TOKEN_HASH_ACTIVE_KEY_IDS_JSON={"device":"v1","pairing_session":"v1","telegram_start":"v1","node":"v1","canary":"v1"}
PROXY_CREDENTIALS_KEYRING_JSON={"v1":"BgYGBgYGBgYGBgYGBgYGBgYGBgYGBgYGBgYGBgYGBgY"}
PROXY_CREDENTIALS_ACTIVE_KEY_ID=v1

TRIAL_DURATION_SECONDS=86400
PAIRING_TOKEN_TTL_SECONDS=600
DEVICE_LIMIT_PER_USER=3
PAIRING_POLL_AFTER_SECONDS=2
PAIRING_INIT_RATE_PER_MINUTE=10
PAIRING_INIT_RATE_PER_HOUR=30
PAIRING_STATUS_RATE_PER_MINUTE=30
STATUS_RATE_PER_MINUTE=120
NODES_RATE_PER_MINUTE=30
NODE_SELECT_RATE_PER_MINUTE=10
DEVICE_LAST_SEEN_WRITE_INTERVAL_SECONDS=60
RATE_LIMIT_RETENTION_SECONDS=7200
RATE_LIMIT_CLEANUP_INTERVAL_SECONDS=3600
# Development only. Production requires exactly the two WireGuard peer host addresses.
TRUSTED_PROXY_CIDRS=["127.0.0.1/32","::1/128","172.16.0.0/12"]
# Use ["chrome-extension://*"] only for a temporary closed test. Replace it with the
# exact store origin before release, e.g. ["chrome-extension://<32-character-id>"].
ALLOWED_EXTENSION_ORIGINS_JSON=[]
# Generate a release key pair with: vpn-discovery-keygen
# DISCOVERY_SIGNING_PRIVATE_KEY=replace-with-generated-private-key
DISCOVERY_SIGNING_KEY_ID=v1
DISCOVERY_DOCUMENT_TTL_SECONDS=3600

TELEGRAM_DELIVERY_MODE=webhook
TELEGRAM_BOT_TOKEN=replace-with-local-test-bot-token
TELEGRAM_BOT_USERNAME=example_vpn_bot
TELEGRAM_WEBHOOK_PUBLIC_BASE_URL=https://bot.example.test
TELEGRAM_WEBHOOK_SECRET=replace-with-32-char-webhook-secret
TELEGRAM_WEBHOOK_PATH_SECRET=replace-with-32-char-path-secret-value
TELEGRAM_UPDATE_MAX_BODY_BYTES=1048576
TELEGRAM_CHANNEL_URL=https://t.me/example_vpn_channel
TELEGRAM_SUPPORT_USERNAME=example_vpn_support
CHROME_WEB_STORE_URL=https://chromewebstore.google.com/
VPN_BRAND_NAME=Virgo
SUBSCRIPTION_REMINDER_POLL_SECONDS=3600

NODE_ASSIGNMENT_HARD_CAPACITY=true
NODE_BLOCK_FAILURE_THRESHOLD=3
NODE_RECOVERY_SUCCESS_THRESHOLD=3
NODE_RECOVERY_REQUIRES_ADMIN=true
CANARY_CHECK_INTERVAL_SECONDS=60
CANARY_PROBE_URLS_JSON=["https://probe-a.example.test/health","https://probe-b.example.test/health"]
CANARY_MIN_SUCCESSFUL_TARGETS=1
NODE_CREDENTIAL_SNAPSHOT_TTL_SECONDS=300
NODE_LONG_POLL_MAX_WAIT_SECONDS=25
NODE_LONG_POLL_CHECK_INTERVAL_SECONDS=0.5
NODE_SNAPSHOT_ACK_TIMEOUT_SECONDS=15
NODE_SNAPSHOT_MAX_MISSED_ACKS=3
NODE_SNAPSHOT_WATCH_INTERVAL_SECONDS=5
NODE_SNAPSHOT_HEARTBEAT_TIMEOUT_SECONDS=75
INTERNAL_API_RATE_PER_MINUTE=120
NODE_SNAPSHOT_ISSUE_RETENTION_SECONDS=86400
TELEMETRY_INSTALL_RATE_PER_MINUTE=30
TELEMETRY_DEVICE_RATE_PER_MINUTE=120
OPERATIONS_HEALTH_POLL_SECONDS=60
OPERATIONS_NODE_TELEMETRY_STALE_SECONDS=120
OPERATIONS_ALERT_COOLDOWN_SECONDS=3600
OPERATIONS_CPU_WARNING_PERCENT=90
OPERATIONS_MEMORY_WARNING_PERCENT=90
OPERATIONS_DISK_WARNING_PERCENT=85
OPERATIONS_TLS_WARNING_DAYS=14
ANALYTICS_RAW_EVENT_RETENTION_DAYS=90
ANALYTICS_CLEANUP_INTERVAL_SECONDS=3600

# Generate with: vpn-admin-password-hash 'replace-this-password'
ADMIN_PANEL_ENABLED=false
ADMIN_PANEL_USERNAME=admin
# ADMIN_PANEL_PASSWORD_HASH=pbkdf2_sha256$...
# A separate bot from the user-facing Telegram bot.
# ADMIN_TELEGRAM_BOT_TOKEN=replace-with-a-different-bot-token-32chars
ADMIN_TELEGRAM_CHAT_IDS_JSON=[]
# METRICS_SCRAPE_TOKEN=replace-with-at-least-32-random-characters
# Monitoring containers are bound to loopback/private networks by default.
# GRAFANA_ADMIN_PASSWORD=replace-with-a-strong-unique-password
# POSTGRES_EXPORTER_DSN=postgresql://vpn:replace@postgres:5432/vpn?sslmode=disable
# GRAFANA_BIND_ADDRESS=127.0.0.1

TARIFFS_JSON={"vpn_15d":{"amount_minor":14900,"period_days":15,"device_limit":2,"currency":"RUB","enabled":true,"description":"Лёгкий стартовый план для базовых задач и поездок"},"vpn_30d":{"amount_minor":29900,"period_days":30,"device_limit":5,"currency":"RUB","enabled":true,"description":"Максимальный комфорт и автоматический выбор сервера"}}
ROBOKASSA_HASH_ALGORITHM=SHA256
ROBOKASSA_IS_TEST=true
PAYMENTS_PRODUCTION_ENABLED=false

PUBLIC_HTTP_PORT=8080

# Local-only example. Copy to .env and replace every value before any shared deployment.
APP_ENV=development
APP_PUBLIC_BASE_URL=http://localhost:8080
PUBLIC_CONTROL_URLS_JSON=["http://localhost:8080","http://localhost:8081"]
APP_BIND_HOST=0.0.0.0
APP_BIND_PORT=8000
LOG_LEVEL=INFO
LOG_FORMAT=json
PROCESS_ROLE=api

POSTGRES_DB=vpn
POSTGRES_USER=vpn
POSTGRES_PASSWORD=vpn-local-only
POSTGRES_LOCAL_PORT=55439
DATABASE_URL=postgresql+asyncpg://vpn:vpn-local-only@postgres:5432/vpn
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=10
DB_STATEMENT_TIMEOUT_MS=10000

WORKER_POLL_INTERVAL_SECONDS=1
OUTBOX_RETRY_BASE_SECONDS=5
OUTBOX_RETRY_MAX_SECONDS=300
OUTBOX_MAX_ATTEMPTS=10

# Deterministic dummy keys for local development only; never reuse in staging/production.
TOKEN_HASH_KEYRING_JSON={"device":{"v1":"AQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQE"},"pairing_session":{"v1":"AgICAgICAgICAgICAgICAgICAgICAgICAgICAgICAgI"},"telegram_start":{"v1":"AwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwM"},"node":{"v1":"BAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQ"},"canary":{"v1":"BQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQU"}}
TOKEN_HASH_ACTIVE_KEY_IDS_JSON={"device":"v1","pairing_session":"v1","telegram_start":"v1","node":"v1","canary":"v1"}
PROXY_CREDENTIALS_KEYRING_JSON={"v1":"BgYGBgYGBgYGBgYGBgYGBgYGBgYGBgYGBgYGBgYGBgY"}
PROXY_CREDENTIALS_ACTIVE_KEY_ID=v1

TRIAL_DURATION_SECONDS=86400
PAIRING_TOKEN_TTL_SECONDS=600
DEVICE_LIMIT_PER_USER=3

TELEGRAM_DELIVERY_MODE=webhook
TELEGRAM_BOT_TOKEN=replace-with-local-test-bot-token
TELEGRAM_BOT_USERNAME=example_vpn_bot
TELEGRAM_WEBHOOK_PUBLIC_BASE_URL=https://bot.example.test
TELEGRAM_WEBHOOK_SECRET=replace-with-32-char-webhook-secret
TELEGRAM_WEBHOOK_PATH_SECRET=replace-with-32-char-path-secret-value

NODE_ASSIGNMENT_HARD_CAPACITY=true
NODE_BLOCK_FAILURE_THRESHOLD=3
NODE_RECOVERY_SUCCESS_THRESHOLD=3
NODE_RECOVERY_REQUIRES_ADMIN=true
CANARY_CHECK_INTERVAL_SECONDS=60
CANARY_PROBE_URLS_JSON=["https://probe-a.example.test/health","https://probe-b.example.test/health"]
CANARY_MIN_SUCCESSFUL_TARGETS=1
NODE_CREDENTIAL_SNAPSHOT_TTL_SECONDS=300

TARIFFS_JSON={"vpn_30d":{"amount_minor":29900,"period_days":30,"currency":"RUB","enabled":true,"description":"Доступ на 30 дней"}}
ROBOKASSA_HASH_ALGORITHM=SHA256
ROBOKASSA_IS_TEST=true
PAYMENTS_PRODUCTION_ENABLED=false

PUBLIC_HTTP_PORT=8080
